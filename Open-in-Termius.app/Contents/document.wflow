	<key>AMApplicationBuild</key>
	<string>521.1</string>
	<key>AMApplicationVersion</key>
	<string>2.10</string>
	<key>AMDocumentVersion</key>
	<string>2</string>
	<key>actions</key>
	<array>
		<dict>
			<key>action</key>
			<dict>
				<key>AMAccepts</key>
				<dict>
					<key>Container</key>
					<string>List</string>
					<key>Optional</key>
					<true/>
					<key>Types</key>
					<array>
						<string>com.apple.applescript.object</string>
					</array>
				</dict>
				<key>AMActionVersion</key>
				<string>1.0.2</string>
				<key>AMApplication</key>
				<array>
					<string>Automator</string>
				</array>
				<key>AMParameterProperties</key>
				<dict>
					<key>source</key>
					<dict/>
				</dict>
				<key>AMProvides</key>
				<dict>
					<key>Container</key>
					<string>List</string>
					<key>Types</key>
					<array>
						<string>com.apple.applescript.object</string>
					</array>
				</dict>
				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run AppleScript.action</string>
				<key>ActionName</key>
				<string>Run AppleScript</string>
				<key>ActionParameters</key>
				<dict>
					<key>source</key>
					<string>use framework "AppKit"
use scripting additions

on run {input, parameters}
    set pasteboard to current application's NSPasteboard's generalPasteboard()
    set savedItems to missing value
    set ownedChangeCount to missing value
    try
        tell application "Finder"
            if (count of Finder windows) is 0 then error "Open a Finder folder window before running Open-in-Termius."
            set currentPath to POSIX path of (target of front Finder window as alias)
        end tell
        set commandText to my shellCommand(currentPath)
        my prepareLocalTerminal()
        -- The window title can update before the terminal input is ready.
        delay 1
        my requireLocalTerminal()

        set savedItems to my copyClipboard(pasteboard)
        pasteboard's clearContents()
        set ownedChangeCount to pasteboard's changeCount() as integer
        if not (pasteboard's setString:commandText forType:(current application's NSPasteboardTypeString)) then error "Could not put the command on the clipboard."
        set ownedChangeCount to pasteboard's changeCount() as integer
        my requireLocalTerminal()
        my requireClipboard(pasteboard, ownedChangeCount)
        tell application "System Events" to tell process "Termius" to key code 9 using command down
        -- Allow Termius to consume the clipboard before Return and restoration.
        delay 1
        my requireLocalTerminal()
        my requireClipboard(pasteboard, ownedChangeCount)
        tell application "System Events" to tell process "Termius" to key code 36
        delay 0.5
        my restoreClipboard(pasteboard, savedItems, ownedChangeCount)
    on error errorMessage number errorNumber
        if ownedChangeCount is not missing value then
            try
                my restoreClipboard(pasteboard, savedItems, ownedChangeCount)
            on error restoreMessage
                set errorMessage to errorMessage &amp; " Clipboard restoration also failed: " &amp; restoreMessage
            end try
        end if
        error "Open-in-Termius: " &amp; errorMessage number errorNumber
    end try
    return input
end run

on shellCommand(folderPath)
    if folderPath contains linefeed or folderPath contains return then error "Folder names containing line breaks are not supported."
    return "cd -- " &amp; quoted form of folderPath &amp; " &amp;&amp; pwd"
end shellCommand

on prepareLocalTerminal()
    my launchTermius()
    -- Cold launch may create a window before its native menu is available.
    -- Readiness must not depend on the initial activation retaining focus.
    my waitForTermius("window/menu readiness", 120)
    my requestTermiusFocus()
    my waitForTermius("foreground focus", 20)
    my openLocalTerminal()
    my waitForTermius("local terminal creation", 60)
    my requestTermiusFocus()
    my waitForTermius("foreground focus", 20)
end prepareLocalTerminal

on launchTermius()
    tell application "Termius" to launch
end launchTermius

on requestTermiusFocus()
    tell application "Termius" to activate
    tell application "System Events" to tell process "Termius" to set frontmost to true
end requestTermiusFocus

on openLocalTerminal()
    tell application "System Events" to tell process "Termius"
        click menu item "New Local Terminal" of menu 1 of menu bar item "File" of menu bar 1
    end tell
end openLocalTerminal

on readTermiusState()
    set currentState to {windowAvailable:false, menuAvailable:false, isForeground:false, windowTitle:"(none)"}
    tell application "System Events"
        if exists process "Termius" then
            tell process "Termius"
                set isForeground of currentState to frontmost
                if (count of windows) &gt; 0 then
                    set windowAvailable of currentState to true
                    set windowTitle of currentState to name of front window
                end if
                if exists menu item "New Local Terminal" of menu 1 of menu bar item "File" of menu bar 1 then
                    set menuAvailable of currentState to enabled of menu item "New Local Terminal" of menu 1 of menu bar item "File" of menu bar 1
                end if
            end tell
        end if
    end tell
    return currentState
end readTermiusState

on pauseForTermius()
    delay 0.25
end pauseForTermius

on waitForTermius(stageName, maxChecks)
    repeat maxChecks times
        set currentState to my readTermiusState()
        if windowAvailable of currentState then
            if stageName is "window/menu readiness" and menuAvailable of currentState then return
            if stageName is "foreground focus" and isForeground of currentState then return
            if stageName is "local terminal creation" and windowTitle of currentState contains "Local Terminal" then return
        end if
        my pauseForTermius()
    end repeat
    error "Timed out waiting for Termius " &amp; stageName &amp; " (window=" &amp; (windowAvailable of currentState as text) &amp; ", menu=" &amp; (menuAvailable of currentState as text) &amp; ", foreground=" &amp; (isForeground of currentState as text) &amp; ", title=" &amp; windowTitle of currentState &amp; ")."
end waitForTermius

on requireLocalTerminal()
    set currentState to my readTermiusState()
    if not isForeground of currentState then error "Termius lost focus. Run Open-in-Termius again without switching apps."
    if not windowAvailable of currentState then error "The Termius window is no longer available."
    if windowTitle of currentState does not contain "Local Terminal" then error "The active Termius window is not a local terminal."
end requireLocalTerminal

on copyClipboard(pasteboard)
    set savedItems to current application's NSMutableArray's array()
    repeat with oldItem in (pasteboard's pasteboardItems() as list)
        set newItem to current application's NSPasteboardItem's alloc()'s init()
        repeat with itemType in (oldItem's types() as list)
            set itemData to oldItem's dataForType:itemType
            if itemData is missing value then error "Could not preserve a clipboard format. The clipboard was left unchanged."
            if not (newItem's setData:itemData forType:itemType) then error "Could not preserve the clipboard."
        end repeat
        savedItems's addObject:newItem
    end repeat
    return savedItems
end copyClipboard

on requireClipboard(pasteboard, ownedChangeCount)
    if (pasteboard's changeCount() as integer) is not ownedChangeCount then error "The clipboard changed while preparing the command. Run Open-in-Termius again."
end requireClipboard

on restoreClipboard(pasteboard, savedItems, ownedChangeCount)
    -- Do not overwrite anything the user copied while the workflow was running.
    if (pasteboard's changeCount() as integer) is not ownedChangeCount then return false
    pasteboard's clearContents()
    if (savedItems's |count|() as integer) &gt; 0 then
        if not (pasteboard's writeObjects:savedItems) then error "Could not restore the previous clipboard contents."
    end if
    return true
end restoreClipboard
</string>
				</dict>
				<key>BundleIdentifier</key>
				<string>com.apple.Automator.RunScript</string>
				<key>CFBundleVersion</key>
				<string>1.0.2</string>
